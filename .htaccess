RewriteEngine On

Options -Indexes

# Bloqueia arquivos e diretorios sensiveis mesmo quando existem fisicamente
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(app|database|storage)(/|$) - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^.*\.(sql|env|log|ini|bak|config)$ - [F,L]

# Assets publicos sem expor /public na URL
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# Se o arquivo ou diretorio existir, serve normalmente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todas as outras requisicoes vao para o roteador
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
